# Roman Urdu Translator - environment configuration
# Is file ko copy karein:  cp .env.example .env   phir values bharein.
# Server .env ko khud nahi parhta; shell se source karein ya Docker --env-file dein.

# ---------- Provider ----------
# openai | gemini | anthropic | mock
# mock = offline testing (koi LLM nahi chalta, quality kachhi hoti hai)
RU_PROVIDER=openai

# Sasta + tez: gpt-4o-mini
# Behtar quality: gpt-4o  |  claude-sonnet-4-5  |  gemini-2.0-flash
# Groq: llama-3.3-70b-versatile
# Ollama: qwen2.5:7b
RU_MODEL=gpt-4o-mini

# ---------- API key ----------
# OpenAI:            sk-...
# Groq:              gsk_...
# Gemini:            AIza...
# Anthropic:         sk-ant-...
RU_API_KEY=

# OpenAI-compatible endpoint badalna ho (Groq / OpenRouter / DeepInfra / Ollama / vLLM)
# Groq:      https://api.groq.com/openai/v1
# OpenRouter:https://openrouter.ai/api/v1
# Ollama:    http://localhost:11434/v1
RU_BASE_URL=https://api.openai.com/v1

# ---------- Quality / behaviour ----------
RU_TEMPERATURE=0.2
RU_MAX_RETRIES=2
RU_TIMEOUT=60

# ---------- HTTP server ----------
PORT=8080
# Set karne par har request mein header lazmi:  Authorization: Bearer <token>
RU_SERVER_TOKEN=

# ---------- Optional: provider ke apne naam (agar RU_API_KEY use nahi karna) ----------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
