[Unit]
Description=Azad Daily autonomous breaking-news agent
After=network-online.target
Wants=network-online.target

[Service]
# 1) put the agent folder at /opt/azad-agent  (sudo cp -r ... /opt/azad-agent)
# 2) sudo useradd -r -s /usr/sbin/nologin azad   (optional hardening)
WorkingDirectory=/opt/azad-agent
ExecStart=/usr/bin/python3 news_agent/autod.py
Restart=always
RestartSec=60
User=root

[Install]
WantedBy=multi-user.target
